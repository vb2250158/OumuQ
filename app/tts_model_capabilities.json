{
  "version": 1,
  "default_request_policy": {
    "upstream": "AI clients may send rich intent fields whenever available.",
    "router": "OumuQ keeps the canonical fields, resolves character defaults, and forwards supported or harmless fields to workers.",
    "worker": "Each worker maps, ignores, or degrades fields according to its engine/model capability."
  },
  "canonical_fields": {
    "correlation": [
      "session_id"
    ],
    "identity": [
      "character_id",
      "speaker",
      "speaker_id",
      "model",
      "worker_url"
    ],
    "content": [
      "text",
      "language",
      "visible_language",
      "speech_language",
      "language_hint"
    ],
    "playback": [
      "play",
      "format",
      "sample_rate"
    ],
    "style": [
      "emotion_mode",
      "emotion_alpha",
      "emotion_tags",
      "emotion_vector",
      "emotion_text",
      "instructions",
      "send_instructions"
    ],
    "prosody": [
      "volume",
      "speech_rate",
      "pitch_rate",
      "speed",
      "pitch"
    ],
    "reference": [
      "prompt_audio",
      "prompt_audios",
      "ref_text",
      "reference_audio_path"
    ],
    "routing": [
      "match_patterns",
      "character_folder"
    ]
  },
  "models": {
    "onnx-vits-split": {
      "provider": "Local",
      "engine": "ONNX-VITS",
      "supports": [
        "text",
        "language",
        "speaker",
        "speaker_id",
        "speed",
        "noise_scale",
        "play"
      ],
      "does_not_support": [
        "zero_shot_voice_cloning",
        "prompt_audio",
        "emotion_vector",
        "provider_instructions",
        "cloud_voice_enrollment"
      ],
      "mapping": {
        "character_id": "registry lookup: onnx_vits_speaker or onnx_vits_speaker_id",
        "speaker": "fixed multi-speaker embedding from the local model config",
        "speed": "inverse VITS duration scale",
        "noise_scale": "latent acoustic variation"
      },
      "notes": [
        "Uses cached enc_p, emb_g, dp, flow, and dec ONNX Runtime sessions.",
        "Model weights and speaker tables are external local assets and are not redistributed by OumuQ."
      ]
    },
    "qwen3-tts-local": {
      "provider": "Local",
      "engine": "Qwen3-TTS",
      "supports": [
        "prompt_audio",
        "prompt_audios",
        "language",
        "text",
        "play"
      ],
      "does_not_support": [
        "cloud_voice_enrollment"
      ],
      "mapping": {
        "emotion_vector": "not guaranteed; prefer text style prompt or engine-specific controls",
        "prompt_audio": "local voice reference"
      }
    },
    "indextts2": {
      "provider": "Local",
      "engine": "IndexTTS2",
      "supports": [
        "prompt_audio",
        "emotion_vector",
        "language",
        "text",
        "play"
      ],
      "mapping": {
        "emotion_vector": "native or worker-specific emotion vector when supported by the running worker",
        "prompt_audio": "local voice reference"
      }
    }
  },
  "playback_policy": {
    "mode": "process-fifo+host-lock",
    "owner": "OumuQ route layer",
    "downstream_worker_play": false,
    "overlap_allowed": false,
    "ordering_scope": "process",
    "playback_mutex_scope": "host",
    "cross_process_fifo": false,
    "order": "route submission sequence within one OumuQ process",
    "status_endpoint": "/api/playback/status"
  }
}
