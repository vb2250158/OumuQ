# Keep reference metadata, but do not commit raw voice assets by default.
voice-references/**/audio/*
!voice-references/**/audio/.gitkeep
voice-references.example/**/audio/*
!voice-references.example/**/audio/.gitkeep

# Local visual reference caches for mascot/design iteration.
# The public repository should keep the README banner, not the bulky reference set.
references/oumuq-character/
assets/branding/*
!assets/branding/
!assets/branding/README.md
!assets/branding/oumuq-readme-banner.png
